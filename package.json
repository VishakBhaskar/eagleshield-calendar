{
  "name": "eagle-shield-calendar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "node scripts/migrate.mjs",
    "start": "npm run db:migrate && node scripts/start.mjs",
    "cal:configure": "node scripts/configure-cal.mjs",
    "cron:reconcile": "node scripts/reconcile.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-isolation=none tests/domain.test.mjs tests/contracts.test.mjs",
    "test:e2e:api": "node --test --test-isolation=none tests/api-e2e.test.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e:api",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "pg-mem": "^3.0.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
